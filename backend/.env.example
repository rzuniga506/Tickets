# =============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - Sistema Tickets TI
# =============================================================================
#
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Actualiza los valores con tus credenciales reales
# 3. NUNCA commitees el archivo .env al repositorio
# 4. El archivo .env debe estar en .gitignore
#
# =============================================================================

# =============================================================================
# BASE DE DATOS
# =============================================================================

# SQL Server Connection String
# Opciones comunes:
# - LocalDB: Server=(localdb)\\mssqllocaldb;Database=TicketsDB;Integrated Security=True
# - SQL Express: Server=localhost\\SQLEXPRESS;Database=TicketsDB;Integrated Security=True
# - Docker: Server=localhost,1433;Database=TicketsDB;User Id=sa;Password=YourPassword;TrustServerCertificate=True
DATABASE_CONNECTION=Server=localhost;Database=TicketsDB;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True

# =============================================================================
# JWT (AUTENTICACIÓN)
# =============================================================================

# Clave secreta para firmar tokens JWT
# Debe ser una cadena larga, aleatoria y segura (mínimo 64 caracteres)
# Genera una con: openssl rand -base64 64
JWT_SECRET_KEY=TuClaveSecretaMuyLargaYSeguraParaProduccionDeMinimo64CaracteresOmas123456789ABCDEFGH

# Emisor del token
JWT_ISSUER=TicketsTI

# Audiencia del token
JWT_AUDIENCE=TicketsTIUsers

# Tiempo de expiración del access token (en minutos)
JWT_EXPIRATION_MINUTES=60

# Tiempo de expiración del refresh token (en días)
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# =============================================================================
# EMAIL (SMTP)
# =============================================================================

# Servidor SMTP
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Office 365: smtp.office365.com
# SendGrid: smtp.sendgrid.net
SMTP_SERVER=smtp.gmail.com

# Puerto SMTP
# 587 (TLS/STARTTLS) - Recomendado
# 465 (SSL)
# 25 (Sin encriptación - NO recomendado)
SMTP_PORT=587

# Credenciales SMTP
# Para Gmail: Usa una "App Password" (https://myaccount.google.com/apppasswords)
# NO uses tu contraseña principal
SMTP_USERNAME=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password-de-16-caracteres

# Email remitente
SMTP_FROM_EMAIL=noreply@tickets.com
SMTP_FROM_NAME=Sistema de Tickets TI

# Habilitar SSL/TLS
SMTP_ENABLE_SSL=true

# =============================================================================
# FIREBASE (NOTIFICACIONES PUSH) - OPCIONAL
# =============================================================================

# Project ID de Firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# Server Key de Firebase Cloud Messaging
FIREBASE_SERVER_KEY=tu-server-key-de-fcm

# =============================================================================
# ALMACENAMIENTO DE ARCHIVOS
# =============================================================================

# Directorio para uploads (relativo o absoluto)
UPLOADS_DIRECTORY=./uploads

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=10

# Extensiones permitidas (separadas por coma)
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip

# =============================================================================
# CORS (CROSS-ORIGIN RESOURCE SHARING)
# =============================================================================

# Orígenes permitidos en producción (separados por coma)
# Ejemplo: https://tickets.tudominio.com,https://app.tudominio.com
ALLOWED_ORIGINS=https://tickets.tudominio.com

# =============================================================================
# LOGGING (SERILOG)
# =============================================================================

# Nivel mínimo de log
# Valores: Verbose, Debug, Information, Warning, Error, Fatal
LOG_LEVEL=Information

# Directorio para archivos de log
LOG_DIRECTORY=./logs

# =============================================================================
# RATE LIMITING (PROTECCIÓN ANTI-ABUSO)
# =============================================================================

# Límite de requests por minuto por IP
RATE_LIMIT_PER_MINUTE=60

# Límite de intentos de login por hora por IP
LOGIN_RATE_LIMIT_PER_HOUR=5

# =============================================================================
# SEGURIDAD
# =============================================================================

# Requerir HTTPS en producción
REQUIRE_HTTPS=true

# Tiempo de sesión en minutos
SESSION_TIMEOUT_MINUTES=30

# Número de intentos de login antes de bloqueo
MAX_LOGIN_ATTEMPTS=5

# Duración del bloqueo en minutos
LOCKOUT_DURATION_MINUTES=30

# =============================================================================
# CARACTERÍSTICAS OPCIONALES
# =============================================================================

# Habilitar Swagger en producción (no recomendado)
ENABLE_SWAGGER_IN_PRODUCTION=false

# Habilitar modo debug
DEBUG_MODE=false

# Habilitar cache de respuestas
ENABLE_RESPONSE_CACHE=true

# =============================================================================
# INFORMACIÓN DE DESPLIEGUE
# =============================================================================

# Entorno de ejecución
# Valores: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# URL base de la API
API_BASE_URL=https://api.tickets.tudominio.com

# URL base del frontend
FRONTEND_URL=https://tickets.tudominio.com

# =============================================================================
# MONITOREO Y ANALYTICS (OPCIONAL)
# =============================================================================

# Application Insights (Azure)
APPLICATION_INSIGHTS_KEY=tu-instrumentation-key

# Sentry DSN (para error tracking)
SENTRY_DSN=https://public@sentry.io/project-id

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# SEGURIDAD:
# - NUNCA commitees credenciales reales al repositorio
# - Usa Azure Key Vault, AWS Secrets Manager o similar en producción
# - Rota las claves regularmente (cada 90 días mínimo)
# - Usa User Secrets en desarrollo: dotnet user-secrets set "Clave" "Valor"
#
# PRODUCCIÓN:
# - Cambia TODAS las claves y contraseñas antes de desplegar
# - Habilita HTTPS y RequireHttpsMetadata
# - Configura AllowedOrigins específicos (no usar AllowAll)
# - Habilita rate limiting
# - Configura logging centralizado
# - Implementa backup automático de base de datos
#
# =============================================================================
